--- a/src/tot/models.py
+++ b/src/tot/models.py
@@ -19,17 +19,21 @@ if api_base != "":
 def completions_with_backoff(**kwargs):
     return openai.ChatCompletion.create(**kwargs)
 
-def gpt(prompt, model="gpt-4", temperature=0.7, max_tokens=1000, n=1, stop=None) -> list:
+def gpt(prompt, model="gpt-4", temperature=0.7, max_tokens=3000, n=1, stop=None, reasoning_effort=None) -> list:  # deepseek-v4-pro 有思考过程，思考 token 计入 max_tokens，1000 会导致 content 为空，实测 3000 足够
