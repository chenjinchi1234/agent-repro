diff --git a/src/tot/methods/bfs.py b/src/tot/methods/bfs.py
index b9d4085..5b38469 100644
--- a/src/tot/methods/bfs.py
+++ b/src/tot/methods/bfs.py
@@ -1,5 +1,7 @@
 import itertools
+import re
 import numpy as np
+from collections import Counter
 from functools import partial
 from tot.models import gpt
 
@@ -31,13 +33,27 @@ def get_votes(task, x, ys, n_evaluate_sample):
     values = task.vote_outputs_unwrap(vote_outputs, len(ys))
     return values
 
-def get_proposals(task, x, y):
-    propose_prompt = task.propose_prompt_wrap(x, y)
-    proposals = gpt(propose_prompt, n=1, stop=None)[0].split('\n')
-    # glm-5.3-flash 会输出 "Possible next steps:" 标题行、示例回显行、✅ 等垃圾，需要过滤；
-    # 合法行两类：① "4 + 5 = 9 (left: 6 9 10)" 步骤行（可能带 "- " 项目符号）；② 到达 24 时走 cot 提示产生的 "Answer: ... = 24" 行（字母开头，必须放行）
+def _current_pool(x, y):
+    """当前剩余数字池。game24 风格轨迹用 "left: ..." 标注剩余数字；
+    非该格式（其它任务）返回 None，表示不做数字池校验。"""
+    tail = y.strip().split('\n')[-1] if y.strip() else x
+    if 'left: ' in tail:
+        tail = tail.split('left: ')[-1].split(')')[0]
+    nums = tail.split()
+    if nums and all(re.fullmatch(r'[\d.]+', n) for n in nums):
+        return Counter(nums)
+    return None
+
+
+def _clean_proposals(raw_lines, pool):
+    """过滤模型输出，只留合法行：
+    ① "4 + 5 = 9 (left: 6 9 10)" 步骤行（可能带 "- " 项目符号）；
+       pool 非 None 时还要求两个操作数都在池里——否则就是模型在回显 propose 的 1-shot 示例
+       （示例输入是 "2 8 8 14"，回显行形状与合法行完全一样，光看格式区分不了）；
+    ② 到达 24 时走 cot 提示产生的 "Answer: ... = 24" 行（字母开头，必须放行）。
+    """
     cleaned = []
-    for _ in proposals:
+    for _ in raw_lines:
         _ = _.strip()
         if _.startswith(('- ', '• ')):  # 去掉项目符号前缀
             _ = _[2:].strip()
@@ -46,9 +62,27 @@ def get_proposals(task, x, y):
         if _.lower().startswith('answer'):
             cleaned.append(_)
         elif _[0].isdigit() and 'left:' in _:
+            if pool is not None:
+                m = re.match(r'([\d.]+)\s*[+\-*/]\s*([\d.]+)\s*=', _)
+                if not m or pool[m.group(1)] <= 0 or pool[m.group(2)] <= 0:
+                    continue
             cleaned.append(_)
-    proposals = cleaned
-    if not proposals:  # 过滤后为空（如已达 24 或死局）时保留原仓库"永不为空"语义，退化为一个空步骤候选
+    return cleaned
+
+
+def get_proposals(task, x, y, max_retry=3):
+    propose_prompt = task.propose_prompt_wrap(x, y)
+    pool = _current_pool(x, y)
+    proposals = []
+    for attempt in range(max_retry + 1):
+        raw = gpt(propose_prompt, n=1, stop=None)[0].split('\n')
+        proposals = _clean_proposals(raw, pool)
+        if proposals:
+            break
+        # 全部被滤掉（模型回显 1-shot 示例 / 输出格式跑偏）→ 重试，避免搜索空转
+        if attempt < max_retry:
+            print(f'  [retry] propose 无合法候选（第 {attempt + 1} 次尝试），重试…')
+    if not proposals:  # 重试后仍为空（如已达 24 或死局）时保留原仓库"永不为空"语义，退化为一个空步骤候选
         proposals = ['']
     return [y + _ + '\n' for _ in proposals]
 
diff --git a/tests/test_proposal_filter.py b/tests/test_proposal_filter.py
new file mode 100644
index 0000000..c89d640
--- /dev/null
+++ b/tests/test_proposal_filter.py
@@ -0,0 +1,90 @@
+"""get_proposals 过滤器的单测（任务书 §8.2：先写一个能失败的检查）
+
+样本全部取自真实日志：
+  - 回显行：题 900 的 new_ys 原文（模型把 propose prompt 的 1-shot 示例抄了一遍）
+  - 合法行：用题 900 的数字 4 5 6 10 构造
+运行：  cd repro/tot && .venv/bin/python tests/test_proposal_filter.py
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src'))
+from tot.methods.bfs import _clean_proposals, _current_pool   # noqa: E402
+
+# ---------- 真实样本 ----------
+# 题 900 = "4 5 6 10"，但模型回显了 propose prompt 的示例（输入 2 8 8 14）
+ECHO_LINES = [
+    '2 + 8 = 10 (left: 8 10 14)',
+    '8 / 2 = 4 (left: 4 8 14)',
+    '14 + 2 = 16 (left: 8 8 16)',
+    '2 * 8 = 16 (left: 8 14 16)',
+    '8 - 2 = 6 (left: 6 8 14)',
+    '14 - 8 = 6 (left: 2 6 8)',
+    '14 /  2 = 7 (left: 7 8 8)',
+    '14 - 2 = 12 (left: 8 8 12)',
+]
+VALID_LINES = [
+    '4 + 5 = 9 (left: 6 9 10)',
+    '10 - 6 = 4 (left: 4 5 4)',
+    '- 6 * 4 = 24 (left: 5 10 24)',      # 带项目符号，且已到 24
+]
+GARBAGE = ['Possible next steps:', '✅', '好的，我来试试', '', '   ']
+ANSWER_LINE = ['Answer: (10 - 4) * 5 - 6 = 24']
+
+POOL_900 = _current_pool('4 5 6 10', '')     # 轨迹为空 → 池 = 题目数字
+
+
+def check(name, got, want):
+    ok = got == want
+    print(f"  {'PASS' if ok else 'FAIL'}  {name}")
+    if not ok:
+        print(f"        期望 {want}\n        实际 {got}")
+    return ok
+
+
+def main():
+    all_ok = True
+    print("=== 1. 数字池推导 ===")
+    all_ok &= check("空轨迹 → 池=题目数字", sorted(POOL_900.elements()), ['10', '4', '5', '6'])
+    all_ok &= check("有 left: 标注 → 池=剩余数字",
+                    sorted(_current_pool('x', '4 + 5 = 9 (left: 6 9 10)\n').elements()),
+                    ['10', '6', '9'])
+    all_ok &= check("非 game24 格式 → 池=None（不做校验）",
+                    _current_pool('Write a passage about coffee.', ''), None)
+
+    print("\n=== 2. 回显行必须被滤掉（本 bug 的核心）===")
+    got = _clean_proposals(ECHO_LINES, POOL_900)
+    all_ok &= check("8 行示例回显全部拒绝", got, [])
+
+    print("\n=== 3. 合法行必须放行 ===")
+    got = _clean_proposals(VALID_LINES, POOL_900)
+    all_ok &= check("3 行合法步骤行全部接受", len(got), 3)
+
+    print("\n=== 4. 其它格式 ===")
+    all_ok &= check("Answer 行放行（不查池）", _clean_proposals(ANSWER_LINE, POOL_900), ANSWER_LINE)
+    all_ok &= check("标题行/表情/中文/空行全拒绝", _clean_proposals(GARBAGE, POOL_900), [])
+    all_ok &= check("pool=None 时退回旧行为（不校验数字池）",
+                    len(_clean_proposals(ECHO_LINES, None)), len(ECHO_LINES))
+
+    print("\n=== 5. 回归对照：旧过滤规则（只看格式）会放行回显 ===")
+    def old_filter(lines):
+        out = []
+        for _ in lines:
+            _ = _.strip()
+            if _.startswith(('- ', '• ')):
+                _ = _[2:].strip()
+            if not _ or not _.isascii():
+                continue
+            if _.lower().startswith('answer') or (_[0].isdigit() and 'left:' in _):
+                out.append(_)
+        return out
+    old_got = old_filter(ECHO_LINES)
+    all_ok &= check("旧规则放行了全部 8 行回显（= bug 成因）", len(old_got), 8)
+
+    print("\n" + ("=" * 50))
+    print("全部通过 ✅" if all_ok else "存在失败 ❌")
+    return 0 if all_ok else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
