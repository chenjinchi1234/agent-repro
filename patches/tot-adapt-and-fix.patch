+
+def chatgpt(messages, model="gpt-4", temperature=0.7, max_tokens=1000, n=1, stop=None, reasoning_effort=None) -> list:
     global completion_tokens, prompt_tokens
     outputs = []
     while n > 0:
-        cnt = min(n, 20)
+        # 网关不支持 n>1，改为每次请求取 1 个样本、循环取满 n 个
+        cnt = 1
         n -= cnt
-        res = completions_with_backoff(model=model, messages=messages, temperature=temperature, max_tokens=max_tokens, n=cnt, stop=stop)
+        kwargs = dict(model=model, messages=messages, temperature=temperature, max_tokens=max_tokens, n=cnt, stop=stop)
+        if reasoning_effort is not None:  # glm-5.3 的 value 判定若用默认推理档会耗竭 max_tokens 返回空内容
+            kwargs['reasoning_effort'] = reasoning_effort
+        res = completions_with_backoff(**kwargs)
         outputs.extend([choice.message.content for choice in res.choices])
         # log completion tokens
         completion_tokens += res.usage.completion_tokens
@@ -44,4 +48,7 @@ def gpt_usage(backend="gpt-4"):
         cost = completion_tokens / 1000 * 0.002 + prompt_tokens / 1000 * 0.0015
     elif backend == "gpt-4o":
         cost = completion_tokens / 1000 * 0.00250 + prompt_tokens / 1000 * 0.01
+    else:
+        # 网关模型不走 GPT-4 计价，成本以网关 usage 接口为准
+        cost = 0
     return {"completion_tokens": completion_tokens, "prompt_tokens": prompt_tokens, "cost": cost}
